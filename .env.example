# ────────────────────────────────────────────────────────────────────────────
# NightCode — environment configuration
# Copy this file to `.env` (gitignored) and fill in the keys you use.
# Bun auto-loads `.env` from the repo root. Never commit real keys.
# ────────────────────────────────────────────────────────────────────────────

# ── Provider / model selection (optional, defaults: groq + qwen/qwen3.6-27b) ──
NIGHTCODE_PROVIDER=groq          # provider id — see docs/providers.md for the full list
NIGHTCODE_MODEL=qwen/qwen3.6-27b # model id within that provider
NIGHTCODE_CONFIG=                # optional path to nightcode.config.json (default: repo root)
# Reasoning effort (off|low|medium|high|max) is set in nightcode.config.json —
# there is currently no env override for it.

# ── Major hosted providers ──────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=                  # Gemini (alias: GEMINI_API_KEY)
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=                     # Grok (alias: GROK_API_KEY)
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=                  # NVIDIA NIM
HF_API_KEY=                      # Hugging Face (alias: HUGGINGFACE_API_KEY)
ZAI_API_KEY=                     # 01.AI / ZAI
MINIMAX_API_KEY=
KIMI_API_KEY=                    # Kimi / Moonshot (alias: MOONSHOT_API_KEY)
OPENCODE_ZEN_API_KEY=            # OpenCode Zen (alias: OPENCODE_API_KEY)
OPENCODE_GO_API_KEY=             # OpenCode Go (alias: OPENCODE_API_KEY)
AI_GATEWAY_TOKEN=                # Vercel AI Gateway

# ── Groq (the provider NightCode shipped with) ──────────────────────────────
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b    # optional per-provider model override
# GROQ_SUMMARIZER=llama-3.1-8b-instant
# GROQ_SUBAGENT=llama-3.1-8b-instant

# ── Cloudflare ──────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=            # alias: CF_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=           # alias: CF_ACCOUNT_ID — fills the {account_id} URL placeholder
CF_GATEWAY_SLUG=                 # fills the {gateway_slug} placeholder (AI Gateway only)

# ── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=            # alias: AZURE_OPENAI_KEY
AZURE_OPENAI_RESOURCE=           # your resource name → https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=         # the model deployment name
AZURE_OPENAI_API_VERSION=2024-06-01

# ── Google Vertex AI (OAuth, no API key — one of the two below) ─────────────
# GOOGLE_OAUTH_ACCESS_TOKEN=                        # short-lived access token
# GOOGLE_APPLICATION_CREDENTIALS=                   # path to a service-account JSON
# GOOGLE_APPLICATION_CREDENTIALS_JSON=              # …or the JSON itself
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# ── Amazon Bedrock (SigV4, no API key — AWS credentials) ────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=               # only for temporary credentials
AWS_REGION=us-east-1             # alias: AWS_DEFAULT_REGION

# ── Local / self-hosted (no keys) ───────────────────────────────────────────
# Defaults are shown; override only if your server is elsewhere.
OLLAMA_BASE_URL=http://localhost:11434/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8000/v1

# ── Memory system ───────────────────────────────────────────────────────────
# Jina embeddings for episodic memory (optional; degrades gracefully if unset)
JINA_API_KEY=
